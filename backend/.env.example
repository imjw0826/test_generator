# Copy to .env and fill in real values. Never commit .env.
DEBUG=false
DATABASE_URL=sqlite:///./data/study_questions.db
UPLOAD_DIR=data/uploads
FIGURE_DIR=data/figures
GENERATED_EXAM_DIR=data/generated_exams

# Comma-separated list of allowed frontend origins.
# Local: http://localhost:3000
# Production: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

# LLM keys (rotate these in the provider dashboards if they ever leak)
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# pdf-inspector layout analysis during PDF processing (headings for chapter
# tags, scanned-page detection). Runs in a child process beside PyMuPDF and is
# abandoned after this many seconds at most. This is the default; the frontend's
# pdf-inspector checkbox (X-PDF-Inspector: on|off header) overrides it per request.
PDF_STRUCTURE_ANALYSIS=true
PDF_STRUCTURE_TIMEOUT_SECONDS=30
